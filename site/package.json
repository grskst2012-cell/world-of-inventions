{
  "name": "world-of-inventions-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Showcase site for the World of Inventions Telegram bot",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/extract-data.mjs && node scripts/check-images.mjs",
    "data:extract": "node scripts/extract-data.mjs",
    "data:images": "node scripts/check-images.mjs",
    "data:map": "node scripts/build-map.mjs",
    "og": "node scripts/make-og.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/hanken-grotesk": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "country-flag-emoji-polyfill": "^0.1.8",
    "d3-geo": "^3.1.1",
    "image-size": "^1.1.1",
    "playwright-core": "^1.48.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "world-atlas": "^2.0.2"
  }
}
